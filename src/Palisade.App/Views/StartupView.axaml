<!--
  Palisade Startup â€” startup entry manager (RyTuneX port). Fluent page.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Palisade.App.ViewModels"
             x:Class="Palisade.App.Views.StartupView"
             x:DataType="vm:StartupViewModel">

  <Grid RowDefinitions="Auto,*,Auto" Margin="28,20,28,16">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Spacing="2">
        <TextBlock Classes="pageTitle" Text="Startup" />
        <TextBlock Classes="secondary"
                   Text="Everything that starts with this account: Run keys, startup folders, logon scheduled tasks and Store app startup tasks. The enable/disable toggle uses Task Manager's own switch." />
      </StackPanel>
      <Button Grid.Column="1" Classes="accent" Content="Refresh" VerticalAlignment="Top"
              Command="{Binding RefreshCommand}" />
    </Grid>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:StartupRowViewModel">
            <Border Classes="card" Margin="0,0,0,8">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Spacing="3">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{Binding IsEnabled, Converter={x:Static vm:EnabledToBrushConverter.Instance}}" />
                    <TextBlock Text="{Binding Name}" Classes="cardTitle" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Impact}" FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                  </StackPanel>
                  <TextBlock Text="{Binding Publisher}" Classes="secondary" FontSize="{StaticResource TypeCaption}" />
                  <TextBlock Text="{Binding Command}" Classes="mono tertiary" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Location}" Classes="mono small" FontSize="10.5"
                             Foreground="{StaticResource TextTertiaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                  <Button Classes="subtle" Content="Remove" MinWidth="0" Padding="8,4"
                          Command="{Binding $parent[ItemsControl].((vm:StartupViewModel)DataContext).RemoveCommand}"
                          CommandParameter="{Binding}" />
                </StackPanel>
                <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                              Command="{Binding $parent[ItemsControl].((vm:StartupViewModel)DataContext).ToggleCommand}"
                              CommandParameter="{Binding}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock Grid.Row="2" Classes="secondary" Text="{Binding StatusLine}" Margin="0,14,0,0" />
  </Grid>
</UserControl>
