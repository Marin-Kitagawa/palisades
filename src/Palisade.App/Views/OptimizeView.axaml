<!--
  Palisade Optimize surface — Fluent page of tuning toggles, ported from RyTuneX.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Palisade.App.ViewModels"
             x:Class="Palisade.App.Views.OptimizeView"
             x:DataType="vm:OptimizeViewModel">

  <Panel>
    <Grid RowDefinitions="Auto,*,Auto" Margin="28,20,28,16">

      <!-- Header -->
      <Grid Grid.Row="0" ColumnDefinitions="*,260" Margin="0,0,0,12">
        <StackPanel Spacing="2">
          <TextBlock Classes="pageTitle" Text="Optimize" />
          <TextBlock Classes="secondary"
                     Text="Tuning toggles ported from RyTuneX. Each toggle runs its original commands and records what it did so it can be reverted." />
        </StackPanel>
        <TextBox Grid.Column="1" PlaceholderText="Search tuning options"
                 Text="{Binding SearchText, Mode=TwoWay}" VerticalAlignment="Top" />
      </Grid>

      <!-- Cards -->
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ToggleGroupViewModel">
                <StackPanel>
                  <TextBlock Margin="0,4,0,8" FontWeight="SemiBold" FontSize="13"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Text="{Binding Name}" />
                  <ItemsControl ItemsSource="{Binding Toggles}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TuningToggleViewModel">
                        <Border Classes="card" Margin="0,0,0,8">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Title}" Classes="cardTitle" TextWrapping="Wrap" />
                                <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="3"
                                        Padding="6,1" VerticalAlignment="Center"
                                        IsVisible="{Binding RequiresElevation}">
                                  <TextBlock Text="admin" FontSize="11"
                                             Foreground="{DynamicResource WarningBrush}" />
                                </Border>
                              </StackPanel>
                              <TextBlock Text="{Binding Description}" Classes="secondary"
                                         FontSize="{StaticResource TypeCaption}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                                          IsChecked="{Binding IsApplied, Mode=TwoWay}"
                                          Command="{Binding $parent[UserControl].((vm:OptimizeViewModel)DataContext).ToggleCommand}"
                                          CommandParameter="{Binding}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Height="8" />
        </StackPanel>
      </ScrollViewer>

      <!-- Command bar -->
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
        <TextBlock Classes="secondary" Text="{Binding StatusLine}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="subtle" Content="Revert all applied"
                Command="{Binding RevertAllCommand}" />
      </Grid>
    </Grid>

    <!-- Busy -->
    <Border IsVisible="{Binding IsBusy}" Background="{DynamicResource SmokeBrush}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
        <ProgressBar IsIndeterminate="True" Width="180" Height="4" />
        <TextBlock Foreground="{DynamicResource TextOnAccentBrush}" Text="Running tuning commands…" />
      </StackPanel>
    </Border>
  </Panel>
</UserControl>
